{
  "name": "aionex-workspace",
  "private": true,
  "workspaces": [
    "website",
    "dashboard"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@aionex/website",
    "dev:website": "npm run dev --workspace=@aionex/website",
    "dev:dashboard": "npm run dev --workspace=@aionex/dashboard",
    "dev:all": "npx concurrently -n \"WEBSITE,DASHBOARD\" -c \"cyan,green\" \"npm run dev:website\" \"npm run dev:dashboard\"",
    "build": "npm run build --workspaces",
    "build:website": "npm run build --workspace=@aionex/website",
    "build:dashboard": "npm run build --workspace=@aionex/dashboard"
  }
}
